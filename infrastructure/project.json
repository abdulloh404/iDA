{
  "name": "infrastructure",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "type:infrastructure"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/rendered.yaml"],
      "options": {
        "command": "kubectl kustomize infrastructure/kubernetes -o infrastructure/rendered.yaml",
        "cwd": "."
      }
    },
    "kube-render": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "kubectl kustomize infrastructure/kubernetes",
        "cwd": "."
      }
    },
    "kube-secrets": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/kube-secrets.mjs",
        "cwd": "."
      }
    },
    "kube-images": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/kube-images.mjs",
        "cwd": ".",
        "tty": true
      }
    },
    "kube-storage": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/kube-storage.mjs",
        "cwd": ".",
        "tty": true
      }
    },
    "kube-restore": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/kube-restore.mjs",
        "cwd": ".",
        "tty": true
      }
    },
    "kube-apply": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/kube-apply.mjs",
        "cwd": "."
      }
    },
    "kube-db-info": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/kube-db-info.mjs",
        "cwd": "."
      }
    },
    "kube-purge": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/kube-purge.mjs",
        "cwd": "."
      }
    }
  }
}
