resolver 127.0.0.11 valid=30s ipv6=off;

upstream ida_core {
    zone ida_core 64k;
    server core-api:8080 resolve;
}

upstream ida_bu01 {
    zone ida_bu01 64k;
    server tenant-bu01:8080 resolve;
}

upstream ida_bu02 {
    zone ida_bu02 64k;
    server tenant-bu02:8080 resolve;
}

upstream ida_web {
    zone ida_web 64k;
    server web:8080 resolve;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    return 308 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${SERVER_NAME};
    ssl_certificate /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 30m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Ida-Service-Key "";
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location ~ ^/[^/]+/api/internal(?:/|$) {
        return 404;
    }

    location /core/ {
        proxy_pass http://ida_core;
    }

    location ${BU01_API_PATH}/ {
        proxy_pass http://ida_bu01;
    }

    location ${BU02_API_PATH}/ {
        proxy_pass http://ida_bu02;
    }

    location / {
        proxy_pass http://ida_web;
    }
}
