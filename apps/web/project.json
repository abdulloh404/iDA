{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [
    "type:frontend",
    "scope:shared"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "syncGenerators": [],
      "options": {
        "command": "npm run typecheck --",
        "cwd": "apps/web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/dist"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/web-settings.mjs",
        {
          "runtime": "node --input-type=module -e \"import { readWebSettings } from './apps/web/web-settings.mjs'; console.log(JSON.stringify(readWebSettings()));\""
        }
      ],
      "options": {
        "command": "npm run build --",
        "cwd": "apps/web"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "syncGenerators": [],
      "options": {
        "command": "npm run dev --",
        "cwd": "apps/web"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "npm run start --",
        "cwd": "apps/web",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "npm run preview --",
        "cwd": "apps/web"
      }
    }
  }
}
