{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [
    "type:frontend",
    "scope:shared"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "syncGenerators": [],
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/web"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": [
            "vite",
            "typescript",
            "@vitejs/plugin-react",
            "@tailwindcss/vite",
            "tailwindcss",
            "react",
            "react-dom"
          ]
        }
      ],
      "options": {
        "command": "tsc --noEmit -p tsconfig.json && vite build",
        "cwd": "apps/web"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "syncGenerators": [],
      "options": {
        "command": "vite",
        "cwd": "apps/web"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node tools/start-web.mjs",
        "cwd": ".",
        "env": {
          "NODE_ENV": "production",
          "HOSTNAME": "127.0.0.1"
        }
      }
    }
  }
}
