{
  "name": "api-tenant-infrastructure",
  "root": "apps/api/iDA.Tanent/infrastructure",
  "sourceRoot": "apps/api/iDA.Tanent/infrastructure",
  "projectType": "library",
  "implicitDependencies": [
    "api-common-infrastructure",
    "api-tenant-application"
  ],
  "tags": [
    "type:library",
    "scope:tenant"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/apps/api/appsettings*.json"
      ],
      "outputs": [
        "{projectRoot}/bin/Release/net9.0"
      ],
      "options": {
        "command": "dotnet build Ida.Tenant.Infrastructure.csproj --configuration Release",
        "cwd": "apps/api/iDA.Tanent/infrastructure"
      }
    }
  }
}
