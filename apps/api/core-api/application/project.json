{
  "name": "api-application",
  "root": "apps/api/core-api/application",
  "sourceRoot": "apps/api/core-api/application",
  "projectType": "library",
  "implicitDependencies": ["api-domain"],
  "tags": ["type:library", "scope:api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/bin/Release/net9.0"],
      "options": {
        "command": "dotnet build Ida.Application.csproj --configuration Release",
        "cwd": "apps/api/core-api/application"
      }
    }
  }
}
