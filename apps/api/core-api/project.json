{
  "name": "core-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/api/core-api",
  "sourceRoot": "apps/api/core-api/api",
  "implicitDependencies": ["api-application", "api-infrastructure"],
  "projectType": "application",
  "tags": ["type:backend", "scope:core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "!{projectRoot}/api/bin/**/*", "!{projectRoot}/api/obj/**/*"],
      "outputs": ["{projectRoot}/api/bin/Release/net9.0"],
      "options": {
        "command": "dotnet build Ida.Api.csproj --configuration Release",
        "cwd": "apps/api/core-api/api"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "ASPNETCORE_URLS=\"http://localhost:${API_PORT:-3100}\" dotnet watch --non-interactive --project Ida.Api.csproj run --no-launch-profile",
        "cwd": "apps/api/core-api/api",
        "env": {
          "DOTNET_ENVIRONMENT": "Development",
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "ASPNETCORE_URLS=\"http://localhost:${API_PORT:-3100}\" dotnet bin/Release/net9.0/iDA.Core.Api.dll",
        "cwd": "apps/api/core-api/api",
        "env": {
          "DOTNET_ENVIRONMENT": "Production",
          "ASPNETCORE_ENVIRONMENT": "Production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "dotnet run --project Ida.Api.csproj --no-launch-profile -- --urls \"http://localhost:${API_PORT:-3100}\"",
        "cwd": "apps/api/core-api/api"
      }
    },
    "migrate-databases": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "dotnet bin/Release/net9.0/iDA.Core.Api.dll --migrate-databases",
        "cwd": "apps/api/core-api/api"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "dotnet bin/Release/net9.0/iDA.Core.Api.dll --seed",
        "cwd": "apps/api/core-api/api"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/api/core-api/Dockerfile -t ida/core-api:dev .",
        "cwd": "."
      }
    }
  }
}
