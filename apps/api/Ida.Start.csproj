<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>iDA.Start</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Startup/**/*.cs" />
    <Compile Include="iDA.Common/infrastructure/Configuration/AppSettings.cs" Link="Configuration/AppSettings.cs" />
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.local.json" CopyToPublishDirectory="Never" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <ProjectReference Include="iDA.Core/api/Ida.Api.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="iDA.Tanent/api/Ida.Tenant.Api.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="IDA.Ingest-worker/Ida.Worker.Ingest.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="PublishApiServices" AfterTargets="Publish">
    <PropertyGroup>
      <ServicePublishRoot>$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))</ServicePublishRoot>
    </PropertyGroup>
    <MSBuild Projects="iDA.Core/api/Ida.Api.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(ServicePublishRoot)/iDA.Core/api/" />
    <MSBuild Projects="iDA.Tanent/api/Ida.Tenant.Api.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(ServicePublishRoot)/iDA.Tanent/api/" />
    <MSBuild Projects="IDA.Ingest-worker/Ida.Worker.Ingest.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(ServicePublishRoot)/IDA.Ingest-worker/" />
  </Target>
</Project>
