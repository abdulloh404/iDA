{
  "name": "api-infrastructure",
  "root": "apps/api/iDA.Infrastructure",
  "sourceRoot": "apps/api/iDA.Infrastructure",
  "projectType": "library",
  "implicitDependencies": [
    "api-application"
  ],
  "tags": [
    "type:library",
    "scope:api"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/apps/api/IDA.Ingest-worker/Sql/*.sql",
        "{workspaceRoot}/apps/api/IDA.Ingest-worker/Fixtures/source-fields.json"
      ],
      "outputs": [
        "{projectRoot}/bin/Release/net9.0"
      ],
      "options": {
        "command": "dotnet build Ida.Infrastructure.csproj --configuration Release",
        "cwd": "apps/api/iDA.Infrastructure"
      }
    }
  }
}
