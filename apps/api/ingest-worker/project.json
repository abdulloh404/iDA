{
  "name": "ingest-worker",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/api/ingest-worker",
  "sourceRoot": "apps/api/ingest-worker",
  "projectType": "application",
  "implicitDependencies": ["api-infrastructure"],
  "tags": ["type:worker", "scope:ingest"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/bin/Release/net9.0"],
      "options": {
        "command": "dotnet build Ida.Worker.Ingest.csproj --configuration Release",
        "cwd": "apps/api/ingest-worker"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "dotnet watch --non-interactive --project Ida.Worker.Ingest.csproj run -- serve --hospital=all",
        "cwd": "apps/api/ingest-worker",
        "env": {
          "DOTNET_ENVIRONMENT": "Development"
        }
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "dotnet bin/Release/net9.0/Ida.Worker.Ingest.dll serve --hospital=all",
        "cwd": "apps/api/ingest-worker",
        "env": {
          "DOTNET_ENVIRONMENT": "Production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "dotnet run --project Ida.Worker.Ingest.csproj -- serve --hospital=all",
        "cwd": "apps/api/ingest-worker"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/api/ingest-worker/Dockerfile -t ida/ingest-worker:dev .",
        "cwd": "."
      }
    }
  }
}
