{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/api",
  "sourceRoot": "apps/api",
  "implicitDependencies": [
    "api-presentation"
  ],
  "projectType": "application",
  "tags": [
    "type:backend"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "!{projectRoot}/**/bin/**/*",
        "!{projectRoot}/**/obj/**/*"
      ],
      "outputs": [
        "{projectRoot}/iDA.Core-api/api/bin/Release/net9.0",
        "{projectRoot}/IDA.Ingest-worker/bin/Release/net9.0",
        "{projectRoot}/iDA.Tanent-api/bin/Release/net9.0"
      ],
      "options": {
        "command": "dotnet build iDA.sln --configuration Release",
        "cwd": "apps/api"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "exec node tools/run-api.mjs dev",
        "cwd": ".",
        "env": {
          "DOTNET_ENVIRONMENT": "Development",
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "exec node tools/run-api.mjs start",
        "cwd": ".",
        "env": {
          "DOTNET_ENVIRONMENT": "Production",
          "ASPNETCORE_ENVIRONMENT": "Production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "exec node tools/run-api.mjs serve",
        "cwd": "."
      }
    },
    "migrate-databases": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "dotnet bin/Release/net9.0/iDA.Core.Api.dll --migrate-databases",
        "cwd": "apps/api/iDA.Core-api/api"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "dotnet bin/Release/net9.0/iDA.Core.Api.dll --seed",
        "cwd": "apps/api/iDA.Core-api/api"
      }
    }
  }
}
