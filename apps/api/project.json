{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/api",
  "sourceRoot": "apps/api",
  "implicitDependencies": [
    "api-application",
    "api-infrastructure"
  ],
  "projectType": "application",
  "tags": [
    "type:backend"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "!{projectRoot}/**/bin/**/*",
        "!{projectRoot}/**/obj/**/*"
      ],
      "outputs": [
        "{projectRoot}/core-api/api/bin/Release/net9.0",
        "{projectRoot}/background-worker/bin/Release/net9.0",
        "{projectRoot}/ingest-worker/bin/Release/net9.0"
      ],
      "options": {
        "command": "dotnet build iDA.sln --configuration Release",
        "cwd": "apps/api"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "commands": [
          "cd core-api/api && ASPNETCORE_URLS=\"http://localhost:${API_PORT}\" dotnet watch --non-interactive --project Ida.Api.csproj run -- --urls \"http://localhost:${API_PORT}\"",
          "cd background-worker && Core__BaseUrl=\"${Core__BaseUrl:-http://localhost:${API_PORT}}\" dotnet watch --non-interactive --project iDA.Bu.Worker.csproj run -- --no-launch-profile",
          "cd ingest-worker && dotnet watch --non-interactive --project Ida.Worker.Ingest.csproj run -- serve --hospital=all"
        ],
        "parallel": true,
        "cwd": "apps/api",
        "env": {
          "DOTNET_ENVIRONMENT": "Development",
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          "cd core-api/api && ASPNETCORE_URLS=\"http://localhost:${API_PORT}\" dotnet bin/Release/net9.0/iDA.Core.Api.dll",
          "cd background-worker && Core__BaseUrl=\"${Core__BaseUrl:-http://localhost:${API_PORT}}\" dotnet bin/Release/net9.0/iDA.Bu.Worker.dll",
          "cd ingest-worker && dotnet bin/Release/net9.0/Ida.Worker.Ingest.dll serve --hospital=all"
        ],
        "parallel": true,
        "cwd": "apps/api",
        "env": {
          "DOTNET_ENVIRONMENT": "Production",
          "ASPNETCORE_ENVIRONMENT": "Production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "commands": [
          "cd core-api/api && dotnet run --project Ida.Api.csproj --no-launch-profile -- --urls \"http://localhost:${API_PORT}\"",
          "cd background-worker && Core__BaseUrl=\"${Core__BaseUrl:-http://localhost:${API_PORT}}\" dotnet run --project iDA.Bu.Worker.csproj",
          "cd ingest-worker && dotnet run --project Ida.Worker.Ingest.csproj -- serve --hospital=all"
        ],
        "parallel": true,
        "cwd": "apps/api"
      }
    },
    "migrate-databases": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "dotnet bin/Release/net9.0/iDA.Core.Api.dll --migrate-databases",
        "cwd": "apps/api/core-api/api"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "dotnet bin/Release/net9.0/iDA.Core.Api.dll --seed",
        "cwd": "apps/api/core-api/api"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker build -f apps/api/core-api/Dockerfile -t ida/core-api:dev .",
          "docker build -f apps/api/background-worker/Dockerfile -t ida/bu-worker:dev .",
          "docker build -f apps/api/ingest-worker/Dockerfile -t ida/ingest-worker:dev ."
        ],
        "parallel": true,
        "cwd": "."
      }
    }
  }
}
