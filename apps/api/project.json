{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/api",
  "sourceRoot": "apps/api",
  "implicitDependencies": [
    "api-core",
    "api-tenant",
    "api-ingest"
  ],
  "projectType": "application",
  "tags": [
    "type:backend"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "!{projectRoot}/**/bin/**/*",
        "!{projectRoot}/**/obj/**/*"
      ],
      "outputs": [
        "{projectRoot}/iDA.Core/api/bin/Release/net9.0",
        "{projectRoot}/IDA.Ingest-worker/bin/Release/net9.0",
        "{projectRoot}/iDA.Tanent/api/bin/Release/net9.0"
      ],
      "options": {
        "command": "dotnet build iDA.sln --configuration Release",
        "cwd": "apps/api"
      }
    },
    "migrate-databases": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node tools/migrate-db.mjs migrate",
        "cwd": "."
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node tools/migrate-db.mjs seed",
        "cwd": "."
      }
    }
  }
}
