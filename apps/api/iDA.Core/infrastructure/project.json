{
  "name": "api-core-infrastructure",
  "root": "apps/api/iDA.Core/infrastructure",
  "sourceRoot": "apps/api/iDA.Core/infrastructure",
  "projectType": "library",
  "implicitDependencies": [
    "api-core-application",
    "api-common-infrastructure"
  ],
  "tags": [
    "type:library",
    "scope:core"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/apps/api/appsettings*.json"
      ],
      "outputs": [
        "{projectRoot}/bin/Release/net9.0"
      ],
      "options": {
        "command": "dotnet build Ida.Core.Infrastructure.csproj --configuration Release",
        "cwd": "apps/api/iDA.Core/infrastructure"
      }
    }
  }
}
