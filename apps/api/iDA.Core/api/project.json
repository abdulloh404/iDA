{
  "name": "api-core",
  "root": "apps/api/iDA.Core/api",
  "sourceRoot": "apps/api/iDA.Core/api",
  "projectType": "application",
  "implicitDependencies": [
    "api-core-infrastructure",
    "api-common"
  ],
  "tags": [
    "type:backend",
    "scope:core"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/appsettings*.json"
      ],
      "outputs": [
        "{projectRoot}/bin/Release/net9.0"
      ],
      "options": {
        "command": "dotnet build Ida.Api.csproj --configuration Release",
        "cwd": "apps/api/iDA.Core/api"
      }
    }
  }
}
