<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\iDA.Infrastructure\Ida.Infrastructure.csproj" />
    <ProjectReference Include="..\iDA.Core-api\application\Ida.Application.csproj" />
    <Compile Include="..\shared\api\**\*.cs" Link="Shared\Api\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\appsettings*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="..\appsettings.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>iDA.Tenant.Api</AssemblyName>
  </PropertyGroup>

</Project>
