<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\iDA.Infrastructure\Ida.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\appsettings*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="..\appsettings.local.json" CopyToPublishDirectory="Never" />
    <Content Include="Fixtures\source-fields.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Sql\install.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Sql\jobs.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
