{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/mobile",
  "sourceRoot": "apps/mobile/lib",
  "projectType": "application",
  "tags": ["type:mobile", "scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/build/app/outputs/flutter-apk"],
      "options": {
        "command": "flutter build apk --release",
        "cwd": "apps/mobile"
      }
    },
    "build-ios": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/build/ios"],
      "options": {
        "command": "flutter build ios --release --no-codesign",
        "cwd": "apps/mobile"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "flutter run",
        "cwd": "apps/mobile"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "node ../../tools/start-mobile.mjs android debug",
        "cwd": "apps/mobile",
        "tty": true
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "node ../../tools/start-mobile.mjs android release",
        "cwd": "apps/mobile",
        "tty": true
      }
    },
    "dev-ios": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "node ../../tools/start-mobile.mjs ios debug",
        "cwd": "apps/mobile",
        "tty": true
      }
    },
    "start-ios": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "node ../../tools/start-mobile.mjs ios release",
        "cwd": "apps/mobile",
        "tty": true
      }
    }
  }
}
