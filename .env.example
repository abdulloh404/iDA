# พอร์ตแอปพลิเคชัน
WEB_PORT=3000
API_PORT=3100

# Local storage สำหรับคลัสเตอร์ Node เดียวบนเครื่องนี้
KUBE_STORAGE_ROOT=/var/lib/ida/storage

CORE_DB_CONNECTION="Host=core-db.core.svc.cluster.local;Port=5432;Database=ida_core;Username=core_app"
CORE_DB_SCHEMA=core
CORE_DB_PASSWORD=REPLACE_ME
CORE_DB_ADMIN_PASSWORD=REPLACE_ME
CORE_DB_LOOKUP_USERNAME=core_lookup
CORE_DB_LOOKUP_PASSWORD=REPLACE_WITH_SEPARATE_READ_ONLY_PASSWORD
CORE_QUEUE_CONNECTION="amqp://core_publisher:REPLACE_ME@queue.core.svc.cluster.local:5672/ida"

BU01_HOSPITAL_ID=BU01
BU01_DB_SCHEMA=bu
BU01_DB_CONNECTION="Host=bu-db.bu01.svc.cluster.local;Port=5432;Database=ida_bu01;Username=bu01user"
BU01_DB_PASSWORD=REPLACE_ME
BU01_DB_ADMIN_PASSWORD=REPLACE_ME
BU01_QUEUE_CONNECTION="amqp://bu01_worker:REPLACE_ME@queue.core.svc.cluster.local:5672/ida"

BU02_HOSPITAL_ID=BU02
BU02_DB_SCHEMA=bu
BU02_DB_CONNECTION="Host=bu-db.bu02.svc.cluster.local;Port=5432;Database=ida_bu02;Username=bu02user"
BU02_DB_PASSWORD=REPLACE_ME
BU02_DB_ADMIN_PASSWORD=REPLACE_ME
BU02_QUEUE_CONNECTION="amqp://bu02_worker:REPLACE_ME@queue.core.svc.cluster.local:5672/ida"

BU03_HOSPITAL_ID=BU03
BU03_DB_SCHEMA=bu
BU03_DB_CONNECTION="Host=bu-db.bu03.svc.cluster.local;Port=5432;Database=ida_bu03;Username=bu03user"
BU03_DB_PASSWORD=REPLACE_ME
BU03_DB_ADMIN_PASSWORD=REPLACE_ME
BU03_QUEUE_CONNECTION="amqp://bu03_worker:REPLACE_ME@queue.core.svc.cluster.local:5672/ida"

Jwt__Key=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
Jwt__Issuer=ida-api
Jwt__Audience=ida-web
Security__DataProtectionKey=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
Security__HashSalt=REPLACE_WITH_RANDOM_SECRET
Seed__AdminUsername=admin
Seed__AdminPassword=REPLACE_WITH_STRONG_PASSWORD
