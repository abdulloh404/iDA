HOSTNAME=localhost

WEB_URL=http://localhost:3000
API_URL=http://localhost:3100

# พอร์ตแอปพลิเคชัน
WEB_PORT=3000
API_PORT=3100

# Storage
KUBE_STORAGE_ROOT=/var/lib/ida/storage

# Core — ฐานข้อมูลและ Queue ส่วนกลาง
CORE_DB_ADMIN_PASSWORD="admin_password_core"
CORE_DB_PASSWORD="password_core"
CORE_DB_CONNECTION="Host=core-db.core.svc.cluster.local;Port=5432;Database=ida_core;Username=core_app"
CORE_QUEUE_CONNECTION="amqp://core_publisher:queue_password_core@queue.core.svc.cluster.local:5672/ida"

# BU01 — สาขาโรงพยาบาลที่ 1
BU01_DB_ADMIN_PASSWORD=
BU01_DB_PASSWORD=
BU01_DB_CONNECTION="Host=bu-db.bu01.svc.cluster.local;Port=5432;Database=ida_bu01;Username=bu01user"
BU01_QUEUE_CONNECTION="amqp://bu01_worker:bu01user@queue.core.svc.cluster.local:5672/ida"

# BU02 — สาขาโรงพยาบาลที่ 2
BU02_DB_ADMIN_PASSWORD=
BU02_DB_PASSWORD=
BU02_DB_CONNECTION="Host=bu-db.bu02.svc.cluster.local;Port=5432;Database=ida_bu02;Username=bu02user"
BU02_QUEUE_CONNECTION="amqp://bu02_worker:bu02user@queue.core.svc.cluster.local:5672/ida"

# BU03 — สาขาโรงพยาบาลที่ 3
BU03_DB_ADMIN_PASSWORD=
BU03_DB_PASSWORD=
BU03_DB_CONNECTION="Host=bu-db.bu03.svc.cluster.local;Port=5432;Database=ida_bu03;Username=bu03user"
BU03_QUEUE_CONNECTION="amqp://bu03_worker:bu03user@queue.core.svc.cluster.local:5672/ida"
